# bdsai E2E Test Environment
# Copy to .env và adjust cho local/CI.

# Web (Next.js) — default 3100 (bdsai convention)
BASE_URL=http://localhost:3100

# API (NestJS) — default 3101
API_URL=http://localhost:3101

# Test environment: local | ci | staging
TEST_ENV=local

# Supabase local (bdsai convention 5435x)
SUPABASE_URL=http://127.0.0.1:54351
SUPABASE_DB_PORT=54352

# Test credentials (seeded by global-setup hoặc pre-existing)
TEST_BUYER_EMAIL=buyer-e2e@bdsai.vn
TEST_BUYER_PASSWORD=E2eBuyer1234

TEST_SELLER_EMAIL=seller-e2e@bdsai.vn
TEST_SELLER_PASSWORD=E2eSeller1234

TEST_ADMIN_EMAIL=admin-e2e@bdsai.vn
TEST_ADMIN_PASSWORD=E2eAdmin1234

TEST_SUPER_ADMIN_EMAIL=super-e2e@bdsai.vn
TEST_SUPER_ADMIN_PASSWORD=E2eSuper1234
