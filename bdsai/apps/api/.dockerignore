# bdsai.vn — apps/api Docker build ignore (Story 1.3, AC6)
# Build context = bdsai/. Loại trừ file không cần để giảm context size + tránh bake secret.

# Dependencies (cài lại trong builder, không copy từ host).
node_modules
**/node_modules

# Build artifacts (build lại trong builder).
dist
**/dist
.next
**/.next
out
**/out
build
**/build

# Turborepo cache.
.turbo
**/.turbo

# Env — KHÔNG bake secret vào image (AD-8).
.env
.env.*
**/.env
**/.env.*
!.env.example

# Test files (không cần runtime).
**/*.spec.ts
**/*.spec.js
**/*.test.ts
**/*.test.js
**/test
coverage
**/coverage

# VCS + editor.
.git
.gitignore
.vscode
.idea
.DS_Store

# Docs + harness (không cần runtime).
docs
_bmad-output
*.md
!packages/shared/README.md

# Supabase local state.
supabase/.branches
supabase/.temp
