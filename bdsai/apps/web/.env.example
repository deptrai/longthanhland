# bdsai.vn — apps/web env mẫu (Story 1.1 + 1.2 + 1.6)
# Copy file này thành `.env.local` rồi điền giá trị thật. `.env.local` KHÔNG commit (.gitignore).
#
# ⚠️ KEY LOCAL SUPABASE LÀ CỐ ĐỊNH cho mọi máy dev (demo key, không nhạy cảm).
#    KEY PROD (Supabase Cloud) KHÔNG BAO GIỜ đưa vào repo.

# --- API gateway (NestJS) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3101

# --- Supabase client phía FE (AD-2: FE read-only + auth; KHÔNG service-role key ở FE) ---
# Gateway kong port 54351 (dải 5435x). anon key là JWT demo local cố định (không nhạy cảm).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54351
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# --- Sentry (Story 1.6 AC4) — error tracking (web) ---
# Optional — để trống (dev) = disabled. Prod: dán DSN từ sentry.io.
# NEXT_PUBLIC_* prefix để client bundle thấy được (public, safe — DSN không nhạy cảm).
# Server-side DSN (SENTRY_DSN) cho Next.js server components xem root .env.example.
NEXT_PUBLIC_SENTRY_DSN=
