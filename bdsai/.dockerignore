# bdsai.vn — Docker build context ignore (Story 1.3, AC6)
# Build context = bdsai/ (docker build -f apps/api/Dockerfile -t bdsai-api:test bdsai/).
# File này ở root context để Docker thực sự áp dụng (bản apps/api/.dockerignore
# giữ theo source tree story; bản này đảm bảo ignore hiệu lực).

# Dependencies (cài lại trong builder).
node_modules
**/node_modules

# Build artifacts (build lại trong builder).
dist
**/dist
.next
**/.next
out
**/out
build
**/build

# Turborepo cache.
.turbo
**/.turbo

# Env — KHÔNG bake secret vào image (AD-8).
.env
.env.*
**/.env
**/.env.*
!.env.example

# Test files.
**/*.spec.ts
**/*.spec.js
**/*.test.ts
**/*.test.js
**/test
coverage
**/coverage

# VCS + editor.
.git
.gitignore
.vscode
.idea
.DS_Store

# Docs + harness.
docs
_bmad-output

# Supabase local state.
supabase/.branches
supabase/.temp
