# bdsai.vn — apps/api env mẫu (Story 1.2)
# Copy file này thành `.env` rồi điền giá trị thật. `.env` KHÔNG commit (.gitignore).
#
# ⚠️ KEY LOCAL SUPABASE LÀ CỐ ĐỊNH cho mọi máy dev (demo key, không nhạy cảm).
#    KEY PROD (Supabase Cloud) KHÔNG BAO GIỜ đưa vào repo.

# Cổng API (khớp Story 1.1)
API_PORT=3101

# --- PostgreSQL (Drizzle + postgres.js) ---
# Local: kết nối trực tiếp DB port 54352 (dải 5435x — xem README/infra-decisions).
# Prod: dùng Supavisor transaction pooler port 6543 (prepare:false bắt buộc).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54352/postgres

# --- Supabase (Auth + Storage), gateway kong port 54351 ---
SUPABASE_URL=http://127.0.0.1:54351

# anon key (public) — JWT demo local cố định
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# service-role key — CHỈ backend (apps/api). JWT demo local cố định.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Bucket lưu ảnh listing (tạo ở story sau; default 'listings')
SUPABASE_STORAGE_BUCKET=listings

# --- Connection pool (AC5 — Supabase Free) ---
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=20

# --- Redis (Story 1.6 AC1) — BullMQ queue backend ---
# Supabase local KHÔNG có Redis. Chạy riêng:
#   docker run -d --name bdsai-redis -p 6379:6379 redis:7-alpine
# Prod: Dokploy VPS chạy Redis container cùng host.
# Optional — default redis://localhost:6379. Nếu Redis down → queue disabled,
# app vẫn boot (graceful degradation E1).
REDIS_URL=redis://localhost:6379

# --- Sentry (Story 1.6 AC4) — error tracking ---
# Optional — để trống (dev) = disabled. Prod: dán DSN từ sentry.io.
# beforeSend redact secret (AD-5/AD-8) — KHÔNG gửi env keys lên Sentry.
SENTRY_DSN=

# --- Monitoring thresholds (Story 1.6 AC7, NFR5) ---
# Supabase Free: DB 500MB → cảnh báo 400MB (80%). Storage 1GB → 800MB (80%).
# Cron hourly check; vượt threshold → log warn + Sentry.captureMessage.
DB_SIZE_ALERT_MB=400
STORAGE_SIZE_ALERT_MB=800
